Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.aladhan.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

<FilesMatch "^(config\.php|\.env|composer\.(json|lock)|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(log|bak|sql|sqlite|ini)$">
  Require all denied
</FilesMatch>
